# CMake build output (out-of-source builds only — never build inside the tree).
# build-*/ covers the sanitizer-specific build dirs the README's own Testing
# section has readers create (build-tsan/, build-asan/, ...) — without this,
# following those instructions leaves an untracked-but-not-ignored directory.
build/
build-*/
cmake-build-*/

# Compiler/IDE artifacts
*.o
*.obj
*.a
*.so
*.dylib
*.exe
compile_commands.json
.cache/
.vscode/
.idea/

# Runtime data (AOF/snapshot files)
data/
*.aof
*.rdb
*.grdb
